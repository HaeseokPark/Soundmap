# /etc/soundmap/soundmap.env 로 복사해서 쓰세요.
#
#   sudo mkdir -p /etc/soundmap
#   sudo cp deploy/soundmap.env.example /etc/soundmap/soundmap.env
#   sudo chown soundmap:soundmap /etc/soundmap/soundmap.env
#   sudo chmod 600 /etc/soundmap/soundmap.env
#   sudo nano /etc/soundmap/soundmap.env     # 값 채우기
#
# 이 파일은 절대 저장소에 커밋하지 마세요. (.gitignore 에 걸려 있습니다)

# ---------- 데이터베이스 ----------
DB_USERNAME=soundmap
DB_PASSWORD=여기에_긴_임의_문자열

# ---------- JWT ----------
# HS256 이라 최소 32바이트가 필요합니다. 아래로 만들어 붙여넣으세요:
#   openssl rand -base64 48
JWT_SECRET=여기에_openssl_로_만든_값
JWT_EXPIRATION_MINUTES=1440

# ---------- 더미 데이터 ----------
# 배포에서는 반드시 false. true 로 두면 실제 서비스에 가짜 사용자 40명이 생깁니다.
SEED_ENABLED=false

# ---------- 로그 ----------
# 개발 기본값(debug/trace)을 그대로 두면 요청마다 SQL 전문이 쌓여
# 작은 인스턴스의 디스크가 금방 찹니다.
LOG_SQL=info
LOG_SQL_PARAMS=info

# ---------- 스키마 ----------
# 처음 띄울 때는 update 로 테이블을 만들고,
# 한 번 만들어진 뒤에는 validate 로 바꾸는 것을 권합니다.
JPA_DDL_AUTO=update

# ---------- CORS ----------
# nginx 가 프론트와 API 를 같은 도메인으로 서비스하면 CORS 자체가 필요 없습니다.
# 그래도 값이 비어 있으면 기동에 실패하므로 도메인을 넣어 둡니다.
CORS_ALLOWED_ORIGINS=https://soundmap.example.com

# ---------- 위치 ----------
# 격자 크기(도). 0.001 = 약 100m. 크게 할수록 익명성이 높아집니다.
LOCATION_GRID_SIZE=0.001
